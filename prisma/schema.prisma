generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// The `id` doubles as the private link token (a UUID has enough entropy
// to be unguessable — no separate token field needed).
model Report {
  id             String   @id @default(uuid())
  clientName     String?
  clientEmail    String?
  // Warm-up context questions (gender, age group, life situation, reason
  // for visiting, career clarity) — not scored, just for the coach's
  // reference. { gender, ageGroup, lifeSituation, reason, clarity }
  profile        Json?
  interestScores Json
  styleScores    Json
  aiContent      Json?
  error          String?
  // Append-only log of send attempts: [{ to, purpose, ok, error, sentAt }, ...]
  emailLog       Json     @default("[]")
  createdAt      DateTime @default(now())
}

// Simple runtime-editable key/value store — currently just the quiz
// passcode, which needs to change from the admin UI without a redeploy
// (unlike env-var-based settings like ADMIN_PASSCODE).
model Setting {
  key   String @id
  value String
}

// A per-client access link: visiting /start/<id> grants quiz access without
// a shared passcode. The `id` doubles as the link token, same pattern as
// Report. Reusable (not single-use) until revoked or past expiresAt, since
// a client closing the tab mid-quiz shouldn't burn their own link.
model Invite {
  id          String    @id @default(uuid())
  label       String?
  clientEmail String?
  expiresAt   DateTime?
  revokedAt   DateTime?
  firstUsedAt DateTime?
  usedCount   Int       @default(0)
  createdAt   DateTime  @default(now())
}

// One row per report-generation attempt, keyed by IP — checked and pruned
// (rows older than the rate-limit window deleted) on every request so this
// never needs a separate cleanup job.
model RateLimitHit {
  id        String   @id @default(uuid())
  ip        String
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}
