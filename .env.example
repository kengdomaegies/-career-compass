# Server-side only — never exposed to the browser.
ANTHROPIC_API_KEY=sk-ant-...

# Postgres connection string (e.g. from Neon, Supabase, or Vercel Postgres).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Email sending (Resend — https://resend.com). Reports auto-email OWNER_EMAIL
# and, if given, the client's email; the report page also has a "send to any
# email" box. Without RESEND_API_KEY, sends fail silently and are logged on
# the report (visible via emailLog) instead of blocking report creation.
RESEND_API_KEY=re_...
# Sender address. The default only works while your Resend account is
# unverified (it can send to any address, good for testing). For production,
# verify a domain in Resend and use an address on it instead.
RESEND_FROM="Career Compass <onboarding@resend.dev>"
# Who gets notified every time a report is generated.
OWNER_EMAIL=alvinkeng@gmail.com

# Admin view (/admin) — lists every report ever generated.
# Pick your own passcode; this is not the artifact's exposed placeholder.
ADMIN_PASSCODE=change-me
# Random secret used to sign the admin session cookie. Generate one with:
#   openssl rand -hex 32
ADMIN_SESSION_SECRET=change-me-too
